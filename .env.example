# Placeholders only. Never commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173

# Neon: pooled URL (host contains -pooler) for the app; direct URL for migrations
DATABASE_URL=
DIRECT_DATABASE_URL=
REDIS_URL=
SESSION_SECRET=
# Must be false/unset in production (startup fails otherwise)
PAYMENTS_SANDBOX=false

# Separate Neon branch for tests; never point at production
TEST_DATABASE_URL=

# Google Identity Services web client ID (sign-in disabled when empty)
GOOGLE_CLIENT_ID=
# 32 random bytes base64 (openssl rand -base64 32); encrypts TOTP seeds. Keep out of backups of the DB.
MFA_ENCRYPTION_KEY=

# Brevo transactional email (sender address must be verified in Brevo)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=NTS Transport
