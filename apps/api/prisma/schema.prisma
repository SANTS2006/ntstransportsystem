// Phase 2 schema: identity, sessions, tenants, memberships, RBAC, audit.
// Tenant-owned tables carry tenant_id; RLS policies and composite FKs live in the SQL migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AuthProvider {
  GOOGLE
}

enum OneTimeTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  MFA_CHALLENGE
}

enum PlatformRole {
  SUPER_ADMIN
  OPERATIONS
  FINANCE
  SUPPORT
  SECURITY_AUDIT
}

enum TenantStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String?    @unique // stored lower-cased and trimmed; absent for phone-only accounts
  phone            String?    @unique // E.164, e.g. +23276123456
  phoneVerifiedAt  DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordHash     String?    @map("password_hash")
  displayName      String     @map("display_name")
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(6)
  mfaEnabled       Boolean    @default(false) @map("mfa_enabled")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities    AuthIdentity[]
  sessions      Session[]
  tokens        OneTimeToken[]
  memberships   Membership[]
  platformRoles PlatformRoleAssignment[]
  mfa           MfaCredential?
  recoveryCodes RecoveryCode[]
  inbox         InboxNotification[]
  phoneOtps     PhoneOtp[]

  @@map("users")
}

model AuthIdentity {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  provider  AuthProvider
  subject   String // verified provider subject, never a client-supplied profile
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid // refresh-token rotation family, for reuse detection
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

model OneTimeToken {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   OneTimeTokenPurpose
  tokenHash String              @unique @map("token_hash") // only the hash is stored
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(6)
  attempts  Int                 @default(0)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("one_time_tokens")
}

/// Platform-wide privilege. Deliberately separate from tenant memberships.
model PlatformRoleAssignment {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  role      PlatformRole
  grantedBy String?      @map("granted_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("platform_role_assignments")
}

model Tenant {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  slug               String       @unique
  status             TenantStatus @default(PENDING)
  timezone           String       @default("UTC")
  defaultCurrency    String       @default("SLE") @map("default_currency")
  crewMinRestMinutes Int          @default(480) @map("crew_min_rest_minutes")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles       Role[]
  memberships Membership[]
  invitations Invitation[]
  locations   Location[]
  vehicles    Vehicle[]
  routes      Route[]
  routeStops  RouteStop[]
  schedules   Schedule[]
  trips       Trip[]

  employees          Employee[]
  driverLicences     DriverLicence[]
  tripCrew           TripCrew[]
  maintenanceRecords MaintenanceRecord[]
  vehicleDocuments   VehicleDocument[]

  serviceBlackouts       ServiceBlackout[]
  seatLayouts            SeatLayout[]
  seatLayoutSeats        SeatLayoutSeat[]
  tripEvents             TripEvent[]
  outboxEvents           OutboxEvent[]
  fares                  Fare[]
  bookings               Booking[]
  bookingPassengers      BookingPassenger[]
  bookingStatusHistory   BookingStatusHistory[]
  paymentSettings        PaymentSettings?
  payments               Payment[]
  tickets                Ticket[]
  notificationDeliveries NotificationDelivery[]
  complaints             Complaint[]
  complaintMessages      ComplaintMessage[]
  tripRatings            TripRating[]
  jobPostings            JobPosting[]
  jobApplications        JobApplication[]
  applicationEvents      ApplicationEvent[]
  storedFiles            StoredFile[]
  inbox                  InboxNotification[]
  manualPayment          ManualPaymentSettings?
  paymentClaims          PaymentClaim[]
  paymentWebhookEvents   PaymentWebhookEvent[]

  @@map("tenants")
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  name      String
  isSystem  Boolean  @default(false) @map("is_system") // immutable safety roles (e.g. owner)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]
  invitations Invitation[]
  locations   Location[]
  vehicles    Vehicle[]
  routes      Route[]
  routeStops  RouteStop[]
  schedules   Schedule[]
  trips       Trip[]

  @@unique([tenantId, key])
  @@unique([tenantId, id]) // target of composite FKs
  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model Membership {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(INVITED)
  invitedBy String?          @map("invited_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Composite FK: the role must belong to the same tenant as the membership.
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id])

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Append-only (enforced by trigger in the migration). tenant_id is null for platform-scope events.
model AuditLog {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?      @map("tenant_id") @db.Uuid
  actorUserId String?      @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?      @map("target_type")
  targetId    String?      @map("target_id")
  outcome     AuditOutcome
  requestId   String?      @map("request_id")
  summary     Json?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// TOTP secret, AES-256-GCM encrypted at rest (key from MFA_ENCRYPTION_KEY, never stored in the DB).
model MfaCredential {
  userId       String    @id @map("user_id") @db.Uuid
  secretEnc    String    @map("secret_enc")
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(6)
  lastUsedStep BigInt?   @map("last_used_step") // TOTP time-step of last accepted code; blocks replay
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_credentials")
}

model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

/// Scoped, single-use, expiring invitation to join a tenant with a specific role.
/// Only sha256(token) is stored. The accepting account's verified email must match `email`.
model Invitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  roleId     String    @map("role_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String?   @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id])

  @@index([tenantId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------------------------
// Phase 4: transport catalog and fleet. Every table is tenant-scoped (RLS in the SQL migration)
// and every cross-table reference is a composite (tenant_id, id) FK, so a row can never point
// at a record that belongs to a different tenant.
// ---------------------------------------------------------------------------------------------

enum LocationKind {
  TERMINAL
  STATION
  STOP
  DEPOT
}

enum VehicleType {
  BUS
  MINIBUS
  SHARED_TAXI
  TAXI
  SHUTTLE
  OTHER
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum RouteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
}

enum TripStatus {
  SCHEDULED
  BOARDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Location {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  name      String
  kind      LocationKind @default(TERMINAL)
  city      String
  address   String?
  latitude  Decimal?     @db.Decimal(9, 6)
  longitude Decimal?     @db.Decimal(9, 6)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originOf      Route[]     @relation("RouteOrigin")
  destinationOf Route[]     @relation("RouteDestination")
  stops         RouteStop[]
  role          Role?       @relation(fields: [roleId], references: [id])
  roleId        String?     @db.Uuid

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("locations")
}

model Vehicle {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  registration    String // upper-cased and trimmed by the application; unique per tenant
  label           String?
  type            VehicleType   @default(BUS)
  make            String?
  model           String?
  year            Int?
  seatingCapacity Int           @map("seating_capacity")
  status          VehicleStatus @default(ACTIVE)
  odometerKm      Int           @default(0) @map("odometer_km")
  seatLayoutId    String?       @map("seat_layout_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trips     Trip[]
  schedules Schedule[]
  role      Role?      @relation(fields: [roleId], references: [id])
  roleId    String?    @db.Uuid

  maintenance MaintenanceRecord[]
  documents   VehicleDocument[]

  seatLayout SeatLayout? @relation(fields: [tenantId, seatLayoutId], references: [tenantId, id])

  @@unique([tenantId, registration])
  @@unique([tenantId, id])
  @@map("vehicles")
}

model Route {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  name                String
  originId            String        @map("origin_id") @db.Uuid
  destinationId       String        @map("destination_id") @db.Uuid
  distanceM           Int           @map("distance_m")
  durationMin         Int           @map("duration_min")
  status              RouteStatus   @default(DRAFT)
  allowedVehicleTypes VehicleType[] @default([]) @map("allowed_vehicle_types") // empty = any type
  minSeats            Int           @default(1) @map("min_seats")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  origin      Location    @relation("RouteOrigin", fields: [tenantId, originId], references: [tenantId, id])
  destination Location    @relation("RouteDestination", fields: [tenantId, destinationId], references: [tenantId, id])
  stops       RouteStop[]
  fares       Fare[]
  schedules   Schedule[]
  trips       Trip[]
  role        Role?       @relation(fields: [roleId], references: [id])
  roleId      String?     @db.Uuid

  blackouts ServiceBlackout[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("routes")
}

model RouteStop {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  routeId    String   @map("route_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  sequence   Int // 1-based order along the route (intermediate stops only)
  offsetMin  Int      @map("offset_min") // minutes after departure at which the vehicle reaches this stop
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route    Route    @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Cascade)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id])
  role     Role?    @relation(fields: [roleId], references: [id])
  roleId   String?  @db.Uuid

  @@unique([routeId, sequence])
  @@unique([routeId, locationId])
  @@map("route_stops")
}

model Schedule {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  routeId          String         @map("route_id") @db.Uuid
  departureTime    String         @map("departure_time") // local wall-clock "HH:MM" in the tenant timezone
  daysOfWeek       Int            @map("days_of_week") // bitmask: Mon=1 Tue=2 Wed=4 Thu=8 Fri=16 Sat=32 Sun=64
  validFrom        DateTime       @map("valid_from") @db.Date
  validTo          DateTime?      @map("valid_to") @db.Date
  defaultVehicleId String?        @map("default_vehicle_id") @db.Uuid
  serviceClass     String?        @map("service_class")
  status           ScheduleStatus @default(ACTIVE)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route          Route    @relation(fields: [tenantId, routeId], references: [tenantId, id])
  defaultVehicle Vehicle? @relation(fields: [tenantId, defaultVehicleId], references: [tenantId, id])
  trips          Trip[]
  role           Role?    @relation(fields: [roleId], references: [id])
  roleId         String?  @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, routeId])
  @@map("schedules")
}

model Trip {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  scheduleId   String?    @map("schedule_id") @db.Uuid
  routeId      String     @map("route_id") @db.Uuid
  serviceDate  DateTime   @map("service_date") @db.Date // the local calendar date of departure
  departureAt  DateTime   @map("departure_at") @db.Timestamptz(6)
  arrivalAt    DateTime   @map("arrival_at") @db.Timestamptz(6)
  vehicleId    String?    @map("vehicle_id") @db.Uuid
  status       TripStatus @default(SCHEDULED)
  delayMinutes Int        @default(0) @map("delay_minutes")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route    Route     @relation(fields: [tenantId, routeId], references: [tenantId, id])
  schedule Schedule? @relation(fields: [tenantId, scheduleId], references: [tenantId, id])
  vehicle  Vehicle?  @relation(fields: [tenantId, vehicleId], references: [tenantId, id])
  role     Role?     @relation(fields: [roleId], references: [id])
  roleId   String?   @db.Uuid

  crew TripCrew[]

  events   TripEvent[]
  bookings Booking[]

  @@unique([scheduleId, serviceDate]) // a schedule yields at most one trip per service date
  @@unique([tenantId, id])
  @@index([tenantId, departureAt])
  @@map("trips")
}

// ---------------------------------------------------------------------------------------------
// Phase 4 slice B: crew (employees, licences, trip crew) and maintenance (records, documents).
// Same rules as slice A: tenant-scoped, RLS, composite (tenant_id, id) FKs.
// ---------------------------------------------------------------------------------------------

enum EmployeeRole {
  DRIVER
  CONDUCTOR
  DISPATCHER
  MECHANIC
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum CrewRole {
  DRIVER
  CONDUCTOR
}

enum MaintenanceKind {
  SERVICE
  REPAIR
  INSPECTION
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VehicleDocumentKind {
  INSURANCE
  INSPECTION_CERTIFICATE
  ROAD_LICENCE
  OTHER
}

model Employee {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  userId         String?        @map("user_id") @db.Uuid // optional link to a platform account
  employeeNumber String         @map("employee_number")
  fullName       String         @map("full_name")
  role           EmployeeRole
  status         EmployeeStatus @default(ACTIVE)
  phone          String?
  hiredOn        DateTime?      @map("hired_on") @db.Date
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  licences DriverLicence[]
  crew     TripCrew[]

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, id])
  @@map("employees")
}

model DriverLicence {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  licenceNumber String   @map("licence_number")
  category      String
  expiresOn     DateTime @map("expires_on") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, licenceNumber])
  @@index([tenantId, employeeId])
  @@map("driver_licences")
}

model TripCrew {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  tripId     String    @map("trip_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  role       CrewRole
  // The trip's time window, copied at assignment so the database can forbid overlapping duty.
  startsAt   DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime  @map("ends_at") @db.Timestamptz(6)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip     Trip     @relation(fields: [tenantId, tripId], references: [tenantId, id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id])

  @@index([tenantId, tripId])
  @@index([tenantId, employeeId])
  @@map("trip_crew")
}

model MaintenanceRecord {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  vehicleId    String            @map("vehicle_id") @db.Uuid
  kind         MaintenanceKind
  status       MaintenanceStatus @default(SCHEDULED)
  scheduledFor DateTime          @map("scheduled_for") @db.Date
  completedOn  DateTime?         @map("completed_on") @db.Date
  description  String
  vendor       String?
  odometerKm   Int?              @map("odometer_km")
  costMinor    Int?              @map("cost_minor") // integer minor units in the company's currency
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [tenantId, vehicleId], references: [tenantId, id])

  @@index([tenantId, vehicleId])
  @@index([tenantId, status, scheduledFor])
  @@map("maintenance_records")
}

model VehicleDocument {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  vehicleId   String              @map("vehicle_id") @db.Uuid
  kind        VehicleDocumentKind
  referenceNo String              @map("reference_no")
  expiresOn   DateTime            @map("expires_on") @db.Date
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, expiresOn])
  @@index([tenantId, vehicleId])
  @@map("vehicle_documents")
}

// ---------------------------------------------------------------------------------------------
// Phase 4 slice C: service calendars, seat layouts, trip event timeline, transactional outbox.
// ---------------------------------------------------------------------------------------------

enum TripEventKind {
  STATUS_CHANGED
  DELAY_SET
  VEHICLE_ASSIGNED
  VEHICLE_REPLACED
  CREW_ASSIGNED
  CREW_RELEASED
  NOTE
}

/// Dates on which no trips run: company-wide (route_id null) or for one route.
model ServiceBlackout {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  routeId   String?  @map("route_id") @db.Uuid
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route  Route? @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, startsOn, endsOn])
  @@map("service_blackouts")
}

model SeatLayout {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seats    SeatLayoutSeat[]
  vehicles Vehicle[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("seat_layouts")
}

model SeatLayoutSeat {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  layoutId   String  @map("layout_id") @db.Uuid
  label      String // e.g. "3C"
  rowNo      Int     @map("row_no")
  colNo      Int     @map("col_no")
  accessible Boolean @default(false)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  layout SeatLayout @relation(fields: [tenantId, layoutId], references: [tenantId, id], onDelete: Cascade)

  @@unique([layoutId, label])
  @@index([tenantId, layoutId])
  @@map("seat_layout_seats")
}

/// Append-only operational timeline for a trip (status, delays, vehicle and crew changes).
model TripEvent {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tripId      String        @map("trip_id") @db.Uuid
  kind        TripEventKind
  details     Json          @default("{}")
  actorUserId String?       @map("actor_user_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip   Trip   @relation(fields: [tenantId, tripId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, tripId, createdAt])
  @@map("trip_events")
}

/// Transactional outbox: rows are written in the same transaction as the change that caused them,
/// then processed asynchronously (retries with backoff; dead-lettered after repeated failure).
model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  payload     Json      @default("{}")
  dedupeKey   String?   @map("dedupe_key")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(6) // dead-lettered: needs an operator

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([processedAt, failedAt, availableAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------------------------
// Phase 5: fares and bookings. Money is integer minor units (never floats).

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

/// A route-level price for a service class. Bookings snapshot the price they were sold at.
model Fare {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  routeId      String   @map("route_id") @db.Uuid
  serviceClass String   @default("STANDARD") @map("service_class")
  amountMinor  Int      @map("amount_minor")
  currency     String   @default("SLE")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route  Route  @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, routeId, serviceClass])
  @@unique([tenantId, id])
  @@map("fares")
}

model Booking {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tripId          String        @map("trip_id") @db.Uuid
  reference       String
  status          BookingStatus @default(PENDING_PAYMENT)
  contactName     String        @map("contact_name")
  contactPhone    String        @map("contact_phone")
  contactEmail    String?       @map("contact_email")
  totalMinor      Int           @map("total_minor")
  currency        String
  holdExpiresAt   DateTime?     @map("hold_expires_at") @db.Timestamptz(6)
  idempotencyKey  String?       @map("idempotency_key")
  requestHash     String?       @map("request_hash")
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip       Trip                   @relation(fields: [tenantId, tripId], references: [tenantId, id])
  passengers BookingPassenger[]
  history    BookingStatusHistory[]
  payments   Payment[]
  claims     PaymentClaim[]
  tickets    Ticket[]
  complaints Complaint[]
  ratings    TripRating[]

  @@unique([tenantId, reference])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@index([tenantId, tripId])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

/// One seat on one booking. `releasedAt` null = the seat is taken; a partial unique index
/// (trip, seat) over live rows is what makes seat inventory atomic under concurrency.
model BookingPassenger {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  bookingId  String    @map("booking_id") @db.Uuid
  tripId     String    @map("trip_id") @db.Uuid
  seatLabel  String    @map("seat_label")
  fullName   String    @map("full_name")
  fareMinor  Int       @map("fare_minor")
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)
  ticket  Ticket?

  @@index([tenantId, bookingId])
  @@index([tenantId, tripId])
  @@map("booking_passengers")
}

/// Append-only history of every booking status change.
model BookingStatusHistory {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  reason      String?
  actorUserId String?        @map("actor_user_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, bookingId, createdAt])
  @@map("booking_status_history")
}

// ---------------------------------------------------------------------------------------------
// Phase 6: payments (Monime). See docs/PAYMENTS.md.

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  PAID_UNFULFILLED // paid after the seats were released: needs a manual refund
}

/// A company's own Monime credentials. Secrets are stored encrypted (AES-256-GCM), never returned.
model PaymentSettings {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  spaceId          String   @map("space_id")
  apiTokenEnc      String   @map("api_token_enc")
  webhookSecretEnc String   @map("webhook_secret_enc")
  enabled          Boolean  @default(true)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payment_settings")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  provider          String        @default("MONIME")
  status            PaymentStatus @default(CREATED)
  amountMinor       Int           @map("amount_minor")
  currency          String
  providerSessionId String?       @map("provider_session_id")
  redirectUrl       String?       @map("redirect_url")
  idempotencyKey    String        @map("idempotency_key")
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  lastError         String?       @map("last_error")
  method            String? // desk payments: CASH | MOBILE_MONEY | BANK_TRANSFER
  collectedBy       String?       @map("collected_by") @db.Uuid
  reference         String? // desk payments: receipt or transaction number
  refundedAt        DateTime?     @map("refunded_at") @db.Timestamptz(6)
  refundedBy        String?       @map("refunded_by") @db.Uuid
  refundReference   String?       @map("refund_reference")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [tenantId, bookingId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, bookingId])
  @@index([tenantId, providerSessionId])
  @@map("payments")
}

/// Processed webhook deliveries, for replay protection and an audit trail.
model PaymentWebhookEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  eventId    String   @map("event_id")
  name       String
  outcome    String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId])
  @@map("payment_webhook_events")
}

// ---------------------------------------------------------------------------------------------
// Phase 7: tickets and boarding.

enum TicketStatus {
  ISSUED
  BOARDED
  VOID
}

/// One ticket per seat of a confirmed booking. The QR code carries a signed token; the signature
/// is checked before the database is consulted, and the ticket's own status decides validity.
model Ticket {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  bookingId       String       @map("booking_id") @db.Uuid
  passengerId     String       @unique @map("passenger_id") @db.Uuid
  tripId          String       @map("trip_id") @db.Uuid
  seatLabel       String       @map("seat_label")
  passengerName   String       @map("passenger_name")
  code            String
  status          TicketStatus @default(ISSUED)
  issuedAt        DateTime     @default(now()) @map("issued_at") @db.Timestamptz(6)
  boardedAt       DateTime?    @map("boarded_at") @db.Timestamptz(6)
  boardedByUserId String?      @map("boarded_by_user_id") @db.Uuid
  voidedAt        DateTime?    @map("voided_at") @db.Timestamptz(6)
  voidReason      String?      @map("void_reason")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking   Booking          @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)
  passenger BookingPassenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, tripId])
  @@index([tenantId, bookingId])
  @@map("tickets")
}

// ---------------------------------------------------------------------------------------------
// Phase 8: notifications. One row per (outbox event, recipient) that has been sent, so a retried
// event never emails the same person twice.

model NotificationDelivery {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  outboxEventId String   @map("outbox_event_id") @db.Uuid
  recipientKey  String   @map("recipient_key")
  template      String
  sentAt        DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([outboxEventId, recipientKey])
  @@index([tenantId, sentAt])
  @@map("notification_deliveries")
}

// ---------------------------------------------------------------------------------------------
// Phase 9: platform-wide settings (maintenance mode). A single row, id = 'singleton'.

model PlatformSetting {
  id                 String    @id @default("singleton")
  maintenanceEnabled Boolean   @default(false) @map("maintenance_enabled")
  maintenanceMessage String?   @map("maintenance_message")
  maintenanceSince   DateTime? @map("maintenance_since") @db.Timestamptz(6)
  updatedBy          String?   @map("updated_by") @db.Uuid
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------------------------
// Phase 10: complaints and trip ratings.

enum ComplaintCategory {
  DELAY
  VEHICLE
  STAFF_CONDUCT
  REFUND
  SAFETY
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum ComplaintAuthor {
  PASSENGER
  STAFF
}

/// A passenger's complaint about a booking, handled by the company's support staff.
model Complaint {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  bookingId  String            @map("booking_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  category   ComplaintCategory
  subject    String
  status     ComplaintStatus   @default(OPEN)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt DateTime?         @map("resolved_at") @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking  Booking            @relation(fields: [tenantId, bookingId], references: [tenantId, id])
  messages ComplaintMessage[]

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([userId, createdAt])
  @@map("complaints")
}

/// The conversation on a complaint. Append-only: history is never rewritten.
model ComplaintMessage {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  complaintId String          @map("complaint_id") @db.Uuid
  authorId    String          @map("author_id") @db.Uuid
  authorKind  ComplaintAuthor @map("author_kind")
  body        String
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  complaint Complaint @relation(fields: [tenantId, complaintId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, complaintId, createdAt])
  @@map("complaint_messages")
}

/// One rating per booking, only after the trip has been completed.
model TripRating {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [tenantId, bookingId], references: [tenantId, id])

  @@unique([bookingId])
  @@index([tenantId, tripId])
  @@map("trip_ratings")
}

// ---------------------------------------------------------------------------------------------
// Phase 12: recruitment.

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

model JobPosting {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  title       String
  jobRole     EmployeeRole @map("job_role")
  description String
  location    String?
  status      JobStatus    @default(DRAFT)
  closesOn    DateTime?    @map("closes_on") @db.Date
  createdBy   String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("job_postings")
}

/// A signed-in person's application to one posting (one per person per posting).
model JobApplication {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  jobId         String            @map("job_id") @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  fullName      String            @map("full_name")
  phone         String
  experience    String
  licenceNumber String?           @map("licence_number")
  status        ApplicationStatus @default(SUBMITTED)
  employeeId    String?           @map("employee_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job    JobPosting         @relation(fields: [tenantId, jobId], references: [tenantId, id], onDelete: Cascade)
  events ApplicationEvent[]

  @@unique([jobId, userId])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([userId, createdAt])
  @@map("job_applications")
}

/// Append-only history of an application: status changes and private HR notes.
model ApplicationEvent {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus? @map("to_status")
  note          String?
  actorUserId   String?            @map("actor_user_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application JobApplication @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, applicationId, createdAt])
  @@map("application_events")
}

// ---------------------------------------------------------------------------------------------
// Phase 13: uploaded documents (CVs, complaint attachments). The bytes live in object storage;
// this table is the index and the access-control record.

enum FileKind {
  APPLICATION_CV
  COMPLAINT_ATTACHMENT
}

model StoredFile {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  kind        FileKind
  ownerId     String    @map("owner_id") @db.Uuid // the application or complaint it belongs to
  objectKey   String    @unique @map("object_key")
  contentType String    @map("content_type")
  sizeBytes   Int       @map("size_bytes")
  sha256      String
  displayName String    @map("display_name")
  uploadedBy  String    @map("uploaded_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind, ownerId])
  @@map("stored_files")
}

// ---------------------------------------------------------------------------------------------
// Phase 14: in-app notifications. Written by the same outbox handlers that send e-mail, for
// recipients who have an account. Rows are only ever marked read, never removed.

model InboxNotification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  outboxEventId String    @map("outbox_event_id") @db.Uuid
  dedupeKey     String    @map("dedupe_key")
  template      String
  title         String
  body          String
  link          String? // a path inside the web app, never an absolute URL
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([outboxEventId, userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("inbox_notifications")
}

// ---------------------------------------------------------------------------------------------
// Phase 18: sign-up and sign-in by phone number. A one-time code is sent by SMS; only a keyed hash
// of it is stored, it expires, and it can be tried a few times.

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET
}

model PhoneOtp {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String
  purpose    OtpPurpose
  userId     String?    @map("user_id") @db.Uuid
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose, createdAt(sort: Desc)])
  @@map("phone_otps")
}

// ---------------------------------------------------------------------------------------------
// Phase 19: paying with QMoney. Monime's checkout does not offer QMoney, so a company can publish
// its own QMoney number; the passenger pays it and sends the transaction id, and staff confirm it
// after checking their QMoney statement.

model ManualPaymentSettings {
  tenantId          String   @id @map("tenant_id") @db.Uuid
  qmoneyNumber      String?  @map("qmoney_number") // E.164
  qmoneyAccountName String?  @map("qmoney_account_name")
  updatedBy         String?  @map("updated_by") @db.Uuid
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("manual_payment_settings")
}

/// A passenger saying "I paid this booking by QMoney, transaction id X". Not proof of anything:
/// it only tells staff what to look for. A booking is confirmed by staff, never by a claim.
model PaymentClaim {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  bookingId  String    @map("booking_id") @db.Uuid
  method     String
  reference  String
  status     String    @default("PENDING") // PENDING | CONFIRMED
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy String?   @map("resolved_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [tenantId, bookingId], references: [tenantId, id])

  @@index([tenantId, bookingId, status])
  @@map("payment_claims")
}
